      },
      "source": [
        "import time\n",
        "import pandas as pd\n",
        "\n",
        "# Define the baseline query for White populations\n",
        "baseline_query = '(\"White People\"[MeSH Terms] OR \"European Ancestry Group\"[MeSH Terms] OR \"white\"[Text Word] OR \"caucasian\"[Text Word])'\n",
        "\n",
        "# Combine with existing queries\n",
        "ns_baseline_query = f'({neuroscience_query}) AND {baseline_query}'\n",
        "no_baseline_query = f'({neuro_oncology_query}) AND {baseline_query}'\n",
        "\n",
        "baseline_results = []\n",
        "print(\"Fetching baseline data (White/Caucasian) from PubMed API... This might take a minute.\")\n",
        "\n",
        "for year in years:\n",
        "    ns_baseline_count = get_pubmed_count(ns_baseline_query, year)\n",
        "    time.sleep(0.35)\n",
