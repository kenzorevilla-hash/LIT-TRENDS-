      "source": [
        "import time\n",
        "import pandas as pd\n",
        "\n",
        "# Define the query for race, ethnicity, and disparities\n",
        "diversity_query = '(\"Healthcare Disparities\"[MeSH Terms] OR \"Continental Population Groups\"[MeSH Terms] OR \"Ethnic Groups\"[MeSH Terms] OR \"Minority Groups\"[MeSH Terms] OR \"race\"[Text Word] OR \"ethnicity\"[Text Word] OR \"minority\"[Text Word] OR \"health disparities\"[Text Word])'\n",
        "\n",
        "# Combine with existing queries\n",
        "ns_div_query = f'({neuroscience_query}) AND {diversity_query}'\n",
        "no_div_query = f'({neuro_oncology_query}) AND {diversity_query}'\n",
        "\n",
        "diversity_results = []\n",
        "print(\"Fetching diversity and representation data from PubMed API... This might take a minute.\")\n",
        "\n",
        "for year in years:\n",
        "    # We already have total counts in the 'df' DataFrame, but we will fetch the subset that includes diversity terms\n",
        "    ns_div_count = get_pubmed_count(ns_div_query, year)\n",
        "    time.sleep(0.35)\n",
        "    no_div_count = get_pubmed_count(no_div_query, year)\n",
        "    time.sleep(0.35)\n",
        "\n",
        "    # Fetch total counts from existing df for proportion calculation\n",
        "    total_ns = df.loc[df['Year'] == year, 'Neuroscience'].values[0] if not df[df['Year'] == year].empty else 1\n",
        "    total_no = df.loc[df['Year'] == year, 'Neuro-oncology'].values[0] if not df[df['Year'] == year].empty else 1\n",
        "\n",
        "    ns_div_prop = (ns_div_count / total_ns * 100) if total_ns > 0 else 0\n",
        "    no_div_prop = (no_div_count / total_no * 100) if total_no > 0 else 0\n",
        "\n",
        "    diversity_results.append({\n",
        "        'Year': year,\n",
        "        'Neuroscience (Diversity/Race)': ns_div_count,\n",
        "        'Neuro-Oncology (Diversity/Race)': no_div_count,\n",
        "        '% of Neuroscience': ns_div_prop,\n",
        "        '% of Neuro-Oncology': no_div_prop\n",
        "    })\n",
        "\n",
        "diversity_df = pd.DataFrame(diversity_results)\n",
        "display(diversity_df.tail())"
      ],
