      "source": [
        "import requests\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "def get_pubmed_count(query, year):\n",
        "    url = \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi\"\n",
        "    full_query = f'({query}) AND (\"{year}/01/01\"[Date - Publication] : \"{year}/12/31\"[Date - Publication])'\n",
        "    params = {\n",
        "        'db': 'pubmed',\n",
        "        'term': full_query,\n",
        "        'retmode': 'json',\n",
        "        'rettype': 'count'\n",
        "    }\n",
        "    try:\n",
        "        response = requests.get(url, params=params)\n",
        "        data = response.json()\n",
        "        return int(data['esearchresult']['count'])\n",
        "    except Exception as e:\n",
        "        print(f\"Error fetching data for {year}: {e}\")\n",
        "        return 0\n",
        "\n",
        "years = list(range(2000, 2026))\n",
        "neuroscience_query = '\"neurosciences\"[MeSH Terms] OR neuroscience[Text Word]'\n",
        "neuro_oncology_query = '\"neuro-oncology\"[Text Word] OR (\"brain neoplasms\"[MeSH Terms])'\n",
        "\n",
        "results = []\n",
        "print(\"Fetching data from PubMed API... This might take a minute to respect rate limits.\")\n",
        "for year in years:\n",
        "    ns_count_raw = get_pubmed_count(neuroscience_query, year)\n",
        "    time.sleep(0.35)  # NCBI rate limit (3 req/sec without API key)\n",
        "    no_count = get_pubmed_count(neuro_oncology_query, year)\n",
        "    time.sleep(0.35)\n",
        "\n",
        "    # Add neuro-oncology to the total count of neuroscience\n",
        "    ns_count = ns_count_raw + no_count\n",
        "\n",
        "    proportion = (no_count / ns_count * 100) if ns_count > 0 else 0\n",
        "    results.append({\n",
        "        'Year': year,\n",
        "        'Neuroscience': ns_count,\n",
        "        'Neuro-oncology': no_count,\n",
        "        'Proportion (%)': proportion\n",
        "    })\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "display(df.head())\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(df['Year'], df['Neuroscience'], marker='o', linestyle='-', color='b', label='Neuroscience (including Neuro-Oncology)')\n",
        "plt.plot(df['Year'], df['Neuro-oncology'], marker='s', linestyle='-', color='r', label='Neuro-Oncology')\n",
        "plt.title('Neuroscience vs. Neuro-Oncology Research Publications (2000-2025)')\n",
        "plt.xlabel('Year')\n",
        "plt.ylabel('Number of Publications')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
