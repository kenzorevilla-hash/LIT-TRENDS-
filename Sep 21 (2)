      "source": [
        "import pandas as pd\n",
        "import time\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "years_to_analyze = list(range(2000, 2026))\n",
        "target_keywords = ['Glioma', 'glioblastoma', 'brain tumor', 'chemotherapy', 'radiotherapy', 'Immunotherapy', 'Stem Cell Transplant']\n",
        "\n",
        "keyword_results = []\n",
        "print(\"Fetching keyword data from PubMed API... This might take a couple of minutes.\")\n",
        "for year in years_to_analyze:\n",
        "    row = {'Year': year}\n",
        "    for kw in target_keywords:\n",
        "        # Added quotes around the text word search to properly handle multi-word keywords like 'brain tumor'\n",
        "        query = f'\"{kw}\"[MeSH Terms] OR \"{kw}\"[Text Word]'\n",
        "        count = get_pubmed_count(query, year)\n",
        "        row[kw] = count\n",
        "        time.sleep(0.35)  # Respect NCBI rate limit\n",
        "    keyword_results.append(row)\n",
        "\n",
        "keyword_trends_df = pd.DataFrame(keyword_results).set_index('Year')\n",
        "display(keyword_trends_df.head())\n",
        "\n",
        "plt.figure(figsize=(14, 8))\n",
        "\n",
        "for keyword in target_keywords:\n",
        "    sns.lineplot(x=keyword_trends_df.index, y=keyword_trends_df[keyword], label=keyword.replace('_', ' ').title(), marker='o')\n",
        "\n",
        "plt.title('Neuro-Oncology Keyword Publication Trends (2000-2025)')\n",
        "plt.xlabel('Year')\n",
        "plt.ylabel('Number of Publications (Containing Keyword)')\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.legend(title='Keywords', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "plt.xticks(years_to_analyze, rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
