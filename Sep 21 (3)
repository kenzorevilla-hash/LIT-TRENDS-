        "!pip install biopython\n",
        "\n",
        "from Bio import Entrez\n",
        "import pandas as pd\n",
        "import time\n",
        "\n",
        "# Set your email for Entrez. This is required by NCBI.\n",
        "Entrez.email = \"your.email@example.com\" # <--- IMPORTANT: Replace with your actual email address\n",
        "\n",
        "# Define the search query using keywords\n",
        "search_query = \"((GBM OR Glioblastoma) AND CAR-Macrophage AND Immunotherapy)\"\n",
        "\n",
        "print(f\"Searching PubMed for: {search_query}\")\n",
        "\n",
        "try:\n",
        "    # Search for articles and retrieve their UIDs\n",
        "    handle = Entrez.esearch(db=\"pubmed\", term=search_query, retmax=\"1000\") # retmax to get up to 1000 results\n",
        "    record = Entrez.read(handle)\n",
        "    handle.close()\n",
        "    id_list = record[\"IdList\"]\n",
        "\n",
        "    if not id_list:\n",
        "        print(\"No papers found matching your criteria.\")\n",
        "    else:\n",
        "        print(f\"Found {len(id_list)} papers. Retrieving details...\")\n",
        "\n",
        "        # Fetch details for each article\n",
        "        # Fetching in batches to avoid overwhelming the server\n",
        "        batch_size = 200\n",
        "        articles_data = []\n",
        "\n",
        "        for i in range(0, len(id_list), batch_size):\n",
        "            batch_ids = id_list[i : i + batch_size]\n",
        "            ids_str = \",\".join(batch_ids)\n",
        "            fetch_handle = Entrez.efetch(db=\"pubmed\", id=ids_str, rettype=\"xml\", retmode=\"xml\")\n",
        "            fetch_record = Entrez.read(fetch_handle)\n",
        "            fetch_handle.close()\n",
        "\n",
        "            for pubmed_article in fetch_record['PubmedArticle']:\n",
        "                article = pubmed_article['MedlineCitation']['Article']\n",
        "                article_info = {}\n",
        "\n",
        "                # Title\n",
        "                article_info['Title'] = article.get('ArticleTitle', 'N/A')\n",
        "\n",
        "                # Authors\n",
        "                authors = []\n",
        "                if 'AuthorList' in article:\n",
        "                    for author in article['AuthorList']:\n",
        "                        if 'LastName' in author and 'Initials' in author:\n",
        "                            authors.append(f\"{author['LastName']} {author['Initials']}\")\n",
        "                        elif 'CollectiveName' in author:\n",
        "                            authors.append(author['CollectiveName'])\n",
        "                article_info['Authors'] = \"; \".join(authors)\n",
        "\n",
        "                # Journal\n",
        "                article_info['Journal'] = article['Journal']['Title'] if 'Journal' in article and 'Title' in article['Journal'] else 'N/A'\n",
        "\n",
        "                # Publication Date\n",
        "                pub_date = article['Journal']['JournalIssue']['PubDate']\n",
        "                year = pub_date.get('Year')\n",
        "                month = pub_date.get('Month')\n",
        "                day = pub_date.get('Day')\n",
        "                article_info['Publication Date'] = f\"{year}-{month or '01'}-{day or '01'}\"\n",
        "\n",
        "                # Abstract\n",
        "                abstract_text = []\n",
        "                if 'Abstract' in article and 'AbstractText' in article['Abstract']:\n",
        "                    for text_part in article['Abstract']['AbstractText']:\n",
        "                        if isinstance(text_part, dict) and '#text' in text_part:\n",
        "                            abstract_text.append(text_part['#text'])\n",
        "                        elif isinstance(text_part, str):\n",
        "                            abstract_text.append(text_part)\n",
        "                article_info['Abstract'] = \" \".join(abstract_text)\n",
        "\n",
        "                # PubMed ID\n",
        "                article_info['PMID'] = pubmed_article['MedlineCitation']['PMID']\n",
        "                article_info['PubMed URL'] = f\"https://pubmed.ncbi.nlm.nih.gov/{pubmed_article['MedlineCitation']['PMID']}/\"\n",
        "\n",
        "                articles_data.append(article_info)\n",
        "            time.sleep(0.3) # Be respectful to the NCBI server\n",
        "\n",
        "        # Create a Pandas DataFrame\n",
        "        df = pd.DataFrame(articles_data)\n",
        "\n",
        "        # Save the DataFrame to a CSV file\n",
        "        output_filename = \"CAR_Macrophage_Glioblastoma_PubMed_Results.csv\"\n",
        "        df.to_csv(output_filename, index=False)\n",
        "\n",
        "        print(f\"Successfully saved {len(df)} papers to {output_filename}\")\n",
        "\n",
        "except Exception as e:\n",
        "    print(f\"An error occurred: {e}\")\n",
        "    print(\"Please ensure you have an internet connection and your email address is set for Entrez.\")"
      ]
